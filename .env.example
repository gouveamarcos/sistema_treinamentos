DJANGO_DEBUG=False
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-unica-e-secreta
DJANGO_ALLOWED_HOSTS=treinamentos.suaempresa.com.br,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://treinamentos.suaempresa.com.br

# Banco SQLite e PDFs fora da pasta do codigo
SQLITE_PATH=C:/Academia/dados/academia.sqlite3
DJANGO_MEDIA_ROOT=C:/Academia/dados/media
SQLITE_TIMEOUT=20

# Alternativa: PostgreSQL (deixe SQLITE_PATH vazio)
# DATABASE_URL=postgres://usuario:senha@host:5432/sistema_treinamentos
# DB_CONN_MAX_AGE=60
# DB_SSLMODE=require

USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
X_FRAME_OPTIONS=DENY
MAX_CSV_IMPORT_SIZE_BYTES=2097152

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.suaempresa.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=treinamentos@suaempresa.com.br
EMAIL_HOST_PASSWORD=senha-do-smtp
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Academia Técnica <treinamentos@suaempresa.com.br>
PASSWORD_RESET_TIMEOUT=604800
